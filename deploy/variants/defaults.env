# Defaults for every variant. A variant file (deploy/variants/<name>.env) overrides these, and
# KEY=VALUE arguments to deploy.sh / render.ts override both. Unknown keys are rejected.

# --- layout ---
# image tag in ECR; deploy/images.sh writes deploy/.out/image-tag, which render.ts uses unless set here
IMAGE_TAG=
# hosts running the Node API; extra ones are taken from the last worker hosts (E8). Empty = inventory roles
API_HOSTS=
# engine processes in total ("all" = every slot of every worker host)
WORKERS=all
# 2 = one process per vCPU, pinned (HT siblings share a core); 1 = one unpinned process per host (E2)
WORKERS_PER_HOST=2
# spread = slot a on every host before any slot b; pack = fill host by host (E1/E2)
WORKER_PLACEMENT=spread
# slot a listens on BASE (admin BASE+1), slot b on BASE+10 (admin BASE+11)
ENGINE_PORT_BASE=7070
# run the one-shot cache-warmer after deploy (E10)
PREWARM=false
# nginx gzip on|off (E9)
GZIP=off
REDIS_MAXMEMORY=1gb
PROMETHEUS_RETENTION=30d

# --- engine ---
ENGINE_THREADS=8
TOP_K=50
MAX_LABELS=500000
SHUTDOWN_GRACE_MS=3000

# --- API (dispatcher) ---
ENGINE_TIMEOUT_MS=5000
ENGINE_CONCURRENCY=2
LB_STRATEGY=least_outstanding
RETRY_MAX=1
HEDGE_AFTER_MS=0
MAX_QUEUE=auto
FAIL_THRESHOLD=3
HEALTH_INTERVAL_MS=2000
NODE_CLUSTER=1
CACHE_BACKEND=redis
CACHE_COALESCE=true
REDIS_LOCK_MS=0
LOG_LEVEL=warn

# --- cache-warmer (only when PREWARM=true) ---
PREWARM_PAIRS=50
PREWARM_TIMES=hourly
PREWARM_DAYS=1
PREWARM_CONCURRENCY=4
