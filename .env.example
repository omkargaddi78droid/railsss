# Copy to .env and adjust. Never commit .env.

# --- public entry point (frontend) ---
PUBLIC_PORT=80

# --- MongoDB (internal only) ---
MONGO_ROOT_USER=railway
MONGO_ROOT_PASSWORD=change-me-to-a-long-random-string
MONGODB_DB=railway

# --- routing engine ---
# HTTP worker threads; one is held per open connection, so keep it above ENGINE_CONCURRENCY
ENGINE_THREADS=8
MIN_TRANSFER_MINUTES=30
MAX_TRANSFERS_INTERNAL=10
# 0 = exact search (default). >0 enables a heuristic per-event label cap.
K_NODE=0
# arrivals must fall within this many minutes of the requested time
SEARCH_HORIZON_MINUTES=5760
# deterministic work budget per query; results stay exact in order, may be fewer than 50 if hit
MAX_LABELS=500000

# --- API ---
ENGINE_TIMEOUT_MS=5000
# max in-flight API->engine requests per engine worker per API process; the rest queue in the API
ENGINE_CONCURRENCY=4
# Route results are cached only in Redis (brotli-compressed, ~10 KB each), never in API memory.
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
# Prewarm: on startup, compute the busiest PREWARM_PAIRS origin/destination pairs at PREWARM_TIMES
# ("hourly" = 00:00..23:00, the frontend's default is the current hour) for PREWARM_DAYS dates into Redis.
PREWARM=true
PREWARM_PAIRS=50
PREWARM_TIMES=hourly
PREWARM_DAYS=1
PREWARM_TZ=Asia/Kolkata
PREWARM_CONCURRENCY=2
# default: (PREWARM_DAYS + 1) days
# PREWARM_TTL_SECONDS=172800
# extra queries: JSON array of {"source","destination","time"}
# PREWARM_FILE=/app/prewarm.json

# --- Scaling study (multi-worker dispatch; defaults keep the single-engine behaviour) ---
# comma-separated engine workers; overrides ENGINE_URL (set in compose)
# ENGINE_URLS=http://w1:7070,http://w2:7070
# round_robin | random | least_outstanding | p2c | consistent_hash
LB_STRATEGY=round_robin
# retry an unavailable worker's request on another worker
RETRY_MAX=1
# duplicate a slow request to a second worker after this many ms (0 = off)
HEDGE_AFTER_MS=0
# 429 beyond workers * ENGINE_CONCURRENCY + MAX_QUEUE in-flight requests (-1 = unlimited)
MAX_QUEUE=-1
FAIL_THRESHOLD=3
HEALTH_INTERVAL_MS=2000
# redis | none (redis needs REDIS_URL; without it the cache is off)
CACHE_BACKEND=redis
CACHE_COALESCE=true
# set in compose
# REDIS_URL=redis://redis:6379
REDIS_TIMEOUT_MS=50
# cross-process stampede lock (0 = off)
REDIS_LOCK_MS=0
# Redis set of worker URLs the pool follows (dynamic join/leave)
# ENGINE_REGISTRY_KEY=engines
# API processes via node:cluster
NODE_CLUSTER=1
# Prometheus metrics listener (internal only)
METRICS_PORT=9464
LOG_LEVEL=info
