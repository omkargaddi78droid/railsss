# Copy to .env and adjust. Never commit .env.

# --- public entry point (frontend) ---
PUBLIC_PORT=80

# --- MongoDB (internal only) ---
MONGO_ROOT_USER=railway
MONGO_ROOT_PASSWORD=change-me-to-a-long-random-string
MONGODB_DB=railway

# --- routing engine ---
# HTTP routing threads; one is held per open keep-alive connection, so keep it at least
# ENGINE_CONCURRENCY x API processes (health checks close their connections)
ENGINE_THREADS=8
# separate two-thread listener for /health and /metrics (point Prometheus here); 0 = off
ADMIN_PORT=7071
# on SIGTERM/SIGINT: /health answers 503 "draining" this long, then the engine stops accepting,
# finishes in-flight searches and exits (keep it above the API's HEALTH_INTERVAL_MS)
SHUTDOWN_GRACE_MS=3000
MIN_TRANSFER_MINUTES=30
MAX_TRANSFERS_INTERNAL=10
# 0 = exact search (default). >0 enables a heuristic per-event label cap.
K_NODE=0
# arrivals must fall within this many minutes of the requested time
SEARCH_HORIZON_MINUTES=5760
# deterministic work budget per query; results stay exact in order, may be fewer than 50 if hit
MAX_LABELS=500000

# --- API ---
ENGINE_TIMEOUT_MS=5000
# max in-flight API->engine requests per engine worker per API process; the rest queue in the API
ENGINE_CONCURRENCY=4
# Route results are cached only in Redis (the engine's compact result, brotli-compressed, ~2 KB each),
# never in API memory. The API renders journeys from its own copy of timetable.json (TIMETABLE_PATH,
# set in the image); its FNV-1a 64 hash must match the engines' and is part of the cache key.
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
# Cache-warmer (one-shot service, runs on `docker compose up`): computes the busiest PREWARM_PAIRS
# origin/destination pairs at PREWARM_TIMES ("hourly" = 00:00..23:00, the frontend's default is the
# current hour) for PREWARM_DAYS dates into Redis, then exits. It waits WARMER_WAIT_MS (120000) for
# Redis and the engine.
PREWARM_PAIRS=50
PREWARM_TIMES=hourly
PREWARM_DAYS=1
PREWARM_TZ=Asia/Kolkata
PREWARM_CONCURRENCY=2
# default: (PREWARM_DAYS + 1) days
# PREWARM_TTL_SECONDS=172800
# extra queries: JSON array of {"source","destination","time"}
# PREWARM_FILE=/app/prewarm.json

# --- Scaling study (multi-worker dispatch; defaults keep the single-engine behaviour) ---
# comma-separated engine workers; overrides ENGINE_URL (set in compose)
# ENGINE_URLS=http://w1:7070,http://w2:7070
# round_robin | random | least_outstanding | p2c | consistent_hash
LB_STRATEGY=round_robin
# retry an unavailable worker's request on another worker
RETRY_MAX=1
# duplicate a slow request to a second worker after this many ms (0 = off)
HEDGE_AFTER_MS=0
# 429 beyond workers * ENGINE_CONCURRENCY + MAX_QUEUE in-flight requests
# (auto = workers * ENGINE_CONCURRENCY, i.e. one capacity of queue; -1 = unlimited)
MAX_QUEUE=auto
FAIL_THRESHOLD=3
HEALTH_INTERVAL_MS=2000
# redis | none (redis needs REDIS_URL; without it the cache is off)
CACHE_BACKEND=redis
CACHE_COALESCE=true
# set in compose
# REDIS_URL=redis://redis:6379
REDIS_TIMEOUT_MS=50
# cross-process stampede lock (0 = off)
REDIS_LOCK_MS=0
# Redis set of worker URLs the pool follows (dynamic join/leave)
# ENGINE_REGISTRY_KEY=engines
# API processes via node:cluster
NODE_CLUSTER=1
# Prometheus metrics listener (internal only)
METRICS_PORT=9464
LOG_LEVEL=info
