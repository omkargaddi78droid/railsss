  "list": [
   {
    "name": "testid",
    "label": "k6 test",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prom"
    },
    "query": {
     "query": "label_values(k6_http_reqs_total, testid)",
     "refId": "q"
    },
    "definition": "label_values(k6_http_reqs_total, testid)",
    "includeAll": true,
    "multi": true,
    "allValue": ".*",
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "refresh": 2
   }
  ]
 },
