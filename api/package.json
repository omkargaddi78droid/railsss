{
  "name": "railway-routing-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "REST API in front of the C++ railway routing engine.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "seed": "node src/scripts/seed-mongo.ts",
    "bench": "node bench/load.ts"
  },
  "dependencies": {
    "express": "^5.2.1",
    "mongodb": "^7.6.0",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "redis": "^6.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.0",
    "autocannon": "^8.0.0",
    "supertest": "^7.3.0",
    "typescript": "^7.0.2"
  }
}
